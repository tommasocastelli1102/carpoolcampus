# Base URL of the backend API. Defaults to the Vite dev proxy (/api -> backend)
# if unset, so this file is only needed if you run the backend somewhere else.
VITE_API_BASE_URL=/api

# Google Maps JavaScript API key (Maps JavaScript API enabled), restricted
# to this app's domains in Google Cloud Console. Required for the map to
# render — see README/deployment notes for how to get one.
VITE_GOOGLE_MAPS_API_KEY=
