# Copy this file to .env and fill in real values for local dev.

# PostgreSQL connection string.
# Create the DB first in pgAdmin (see README.md), e.g. a database named "carpoolcampus".
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/carpoolcampus

# JWT signing secret - use a long random string in real deployments.
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
